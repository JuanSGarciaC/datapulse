# Copia este archivo a .env y CAMBIA todas las contraseñas.
# .env está en .gitignore: nunca lo subas al repositorio.

# --- General ---------------------------------------------------------------
DATAPULSE_ENV=dev                 # dev | test | prod (prod exige contraseñas >= 16 caracteres)
DATAPULSE_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
DATAPULSE_LOG_FORMAT=json         # json | console

# --- PostgreSQL (usuario administrador: solo migraciones y bootstrap) -------
DATAPULSE_DB_HOST=localhost
DATAPULSE_DB_PORT=5433            # puerto publicado por docker compose en tu máquina
DATAPULSE_DB_NAME=datapulse
DATAPULSE_DB_USER=datapulse_admin
DATAPULSE_DB_PASSWORD=change-me-admin
POSTGRES_HOST_PORT=5433           # cámbialo si 5433 ya está ocupado

# --- Usuarios de servicio (mínimo privilegio, ver docs/adr/0005) ------------
DATAPULSE_PIPELINE_DB_PASSWORD=change-me-pipeline
DATAPULSE_DBT_DB_PASSWORD=change-me-dbt
DATAPULSE_API_DB_PASSWORD=change-me-api

# --- API simulada (mock-source, fase 2) ------------------------------------
MOCK_HOST_PORT=8081
DATAPULSE_MOCK_ADMIN_TOKEN=change-me-mock-admin
# Fallos al arrancar (JSON). Ej.: {"fail_rate":0.1,"rate_limit":60,"fail_offsets":{"30":2}}
DATAPULSE_MOCK_FAULTS={}

# --- Orquestación (Prefect, fase 4) ----------------------------------------
PREFECT_HOST_PORT=4200
DATAPULSE_FLOW_DAILY_CRON="0 6 * * *"   # entre comillas: el valor tiene espacios
DATAPULSE_FLOW_TASK_RETRIES=2
DATAPULSE_FLOW_TASK_RETRY_DELAY_S=10
# Fuente de productos al ejecutar en tu máquina (scripts/dev.ps1, make): la API simulada
# local, o la real (https://dummyjson.com).
DATAPULSE_INGEST_PRODUCTS_API_URL=http://127.0.0.1:8081
# La misma fuente vista desde los contenedores (nombre interno de Docker Compose).
DOCKER_PRODUCTS_API_URL=http://mock-source:8081
DATAPULSE_INGEST_OVERLAP_MINUTES=60

# --- dbt (fase 5): usuario datapulse_dbt, actúa como dp_transform -----------
DATAPULSE_DBT_DB_USER=datapulse_dbt
# DATAPULSE_DBT_DB_PASSWORD se toma del bloque de usuarios de servicio de arriba

# --- API de indicadores (fase 6) -------------------------------------------
API_HOST_PORT=8000
# Claves de lectura (>= 16 caracteres), separadas por comas: una por consumidor,
# para poder rotarlas o revocarlas por separado.
DATAPULSE_API_KEYS=change-me-api-key-0001,change-me-dashboard-key-0001
# Clave de administración (disparar pipelines). Vacía = endpoint deshabilitado (404).
DATAPULSE_API_ADMIN_KEY=change-me-admin-key-0001

# --- Dashboard (fase 7) ------------------------------------------------------
DASHBOARD_HOST_PORT=8501
# Debe ser una de las claves de DATAPULSE_API_KEYS.
DATAPULSE_DASHBOARD_API_KEY=change-me-dashboard-key-0001
DATAPULSE_API_DOCS_ENABLED=true

# --- Pruebas de integración (base dedicada, se reconstruye en cada prueba) --
DATAPULSE_TEST_DB_HOST=localhost
DATAPULSE_TEST_DB_PORT=5433
DATAPULSE_TEST_DB_NAME=datapulse_test
DATAPULSE_TEST_DB_USER=datapulse_admin
DATAPULSE_TEST_DB_PASSWORD=change-me-admin
